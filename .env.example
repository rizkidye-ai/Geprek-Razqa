# Connection string database PostgreSQL (gratis lewat neon.tech atau supabase.com).
# Contoh format Neon: postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=""
AUTH_SECRET="ganti-dengan-string-acak-yang-panjang-dan-rahasia"

# Opsional: hanya dipakai oleh `npm run db:seed`.
# Set nilai unik untuk setiap instance/pelanggan sebelum deploy ke production.
# Kalau dikosongkan, password default "geprek123" akan dipakai (jangan dipakai di production!).
SEED_ADMIN_PASSWORD=""
SEED_KASIR_PASSWORD=""
SEED_DAPUR_PASSWORD=""
